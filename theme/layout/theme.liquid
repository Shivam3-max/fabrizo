<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0a0a0a">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{%- endif -%}
  <title>{% if page_title %}{{ page_title }} – {% endif %}{{ shop.name }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,500;1,700&family=Italiana&family=Libre+Baskerville:ital@1&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root { --accent: {{ settings.color_accent | default: '#c40500' }}; --sale: {{ settings.color_sale | default: '#c40500' }}; --ink: {{ settings.color_ink | default: '#0a0a0a' }}; }
  </style>
  <script>document.documentElement.classList.replace('no-js','js');</script>
  {{ content_for_header }}
</head>
<body class="tpl-{{ template.name }}{% if template.suffix %} tpl-{{ template.name }}--{{ template.suffix }}{% endif %}">
  <a class="skip-link visually-hidden" href="#main">Skip to content</a>
  {% sections 'header-group' %}
  <main id="main" role="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}

  {%- render 'cart-drawer' -%}
  {%- render 'search-overlay' -%}
  {%- render 'mobile-nav' -%}
  <div class="overlay" data-overlay></div>
  <div class="toast" role="status" aria-live="polite" data-toast></div>

  <script>
    window.Fabrizo = {
      routes: { cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | append: '.js' | json }}, cartChange: {{ routes.cart_change_url | append: '.js' | json }}, search: {{ routes.search_url | json }}, suggest: {{ routes.predictive_search_url | append: '.json' | json }} },
      moneyFormat: {{ shop.money_format | json }},
      freeShipping: {{ settings.free_shipping_threshold | default: 0 | times: 100 }},
      whatsapp: {{ settings.whatsapp_number | json }},
      offerTiers: [{ spend: {{ settings.offer_1_spend | default: 0 | times: 100 }}, reward: {{ settings.offer_1_reward | json }} }, { spend: {{ settings.offer_2_spend | default: 0 | times: 100 }}, reward: {{ settings.offer_2_reward | json }} }, { spend: {{ settings.offer_3_spend | default: 0 | times: 100 }}, reward: {{ settings.offer_3_reward | json }} }],
      offerOn: {{ settings.offer_enabled | json }}
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
