<div class="page-width section">
  {%- if section.settings.show_title -%}<h1 class="h-sec h-sec--lg" style="margin-bottom:18px">{{ page.title }}</h1>{%- endif -%}
  <div class="rte">{{ page.content }}</div>
</div>
{% schema %}{ "name": "Page content", "settings": [ { "type": "checkbox", "id": "show_title", "label": "Show title", "default": true } ] }{% endschema %}
