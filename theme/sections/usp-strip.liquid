<section class="usp">
  <div class="page-width usp__grid">
    {%- for block in section.blocks -%}
      <div class="usp__item" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<span class="usp__t">{{ block.settings.title }}</span><span class="usp__s">{{ block.settings.text }}</span></div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Trust strip",
  "blocks": [ { "type": "item", "name": "Item", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [ { "value": "truck", "label": "Delivery" }, { "value": "card", "label": "Payment" }, { "value": "chat", "label": "Chat" }, { "value": "exchange", "label": "Exchange" }, { "value": "shield", "label": "Shield" }, { "value": "brush", "label": "Print" } ] },
    { "type": "text", "id": "title", "label": "Title" }, { "type": "text", "id": "text", "label": "Text" } ] } ],
  "max_blocks": 4,
  "presets": [ { "name": "Trust strip" } ]
}
{% endschema %}
