{%- comment -%}
  One anime, one block: e.g. "Naruto". A coloured panel (Japanese title,
  tagline, character shortcuts, CTA) beside a rail of every design from that
  anime's collection. Add one per anime you want on a page.
{%- endcomment -%}
{%- liquid
  assign col = section.settings.collection
  assign h = col.handle
  capture accent
    render 'uni', handle: h, get: 'accent', collection: col
  endcapture
  capture kanji
    render 'uni', handle: h, get: 'kanji', collection: col
  endcapture
  capture line
    render 'uni', handle: h, get: 'line', collection: col
  endcapture
  assign title = section.settings.title | default: col.title
  assign pi = section.settings.image_n | minus: 1
  assign im = section.settings.image | default: section.settings.image_product.images[pi] | default: col.image | default: col.products.first.featured_image
-%}
{%- if col -%}
<section class="section{% if section.settings.tight %} section--tight{% endif %}" style="--uni: {{ accent }}" id="spot-{{ h }}">
  <div class="page-width spot">
    <div class="spot__panel">
      {%- if im -%}<img class="spot__panel-img" src="{{ im | image_url: width: 700 }}" alt="" loading="lazy" width="{{ im.width }}" height="{{ im.height }}">{%- endif -%}
      {%- if kanji != blank -%}<span class="spot__kanji{% if kanji.size > 5 %} is-long{% endif %}" aria-hidden="true">{{ kanji }}</span>{%- endif -%}
      <p class="spot__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="spot__title">{{ title }}</h2>
      {%- if line != blank -%}<p class="spot__line">{{ section.settings.text | default: line }}</p>{%- endif -%}
      <p class="spot__count">{{ col.products_count }} {% if col.products_count == 1 %}design{% else %}designs{% endif %}</p>
      {%- assign chars = section.settings.characters | split: ',' -%}
      {%- if section.settings.characters != blank -%}
        <div class="spot__chars">
          {%- for c in chars -%}<a href="{{ routes.search_url }}?q={{ c | strip | url_encode }}&type=product">{{ c | strip }}</a>{%- endfor -%}
        </div>
      {%- endif -%}
      {% render 'type-links', col: col, cls: 'tlinks--panel' %}
      <div class="spot__cta"><a href="{{ col.url }}" class="btn btn--light">Shop all {{ title }}</a></div>
    </div>
    <div class="spot__rail rail" data-rail>
      <div class="rail__track" data-rail-track>
        {%- for p in col.products limit: section.settings.limit -%}{% render 'product-card', product: p, show_uni: false %}{%- endfor -%}
      </div>
      <button type="button" class="rail__btn rail__btn--prev" data-rail-prev aria-label="Previous" disabled>{% render 'icon', name: 'chev-left', class: 'ico--sm' %}</button>
      <button type="button" class="rail__btn rail__btn--next" data-rail-next aria-label="Next">{% render 'icon', name: 'chev-right', class: 'ico--sm' %}</button>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "World spotlight",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (anime, Marvel, Mood Tees…)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Anime universe" },
    { "type": "text", "id": "title", "label": "Heading (defaults to collection title)" },
    { "type": "textarea", "id": "text", "label": "Tagline (defaults to the anime's built-in line)" },
    { "type": "text", "id": "characters", "label": "Character shortcuts", "info": "Comma separated, each searches that name" },
    { "type": "image_picker", "id": "image", "label": "Panel image" },
    { "type": "product", "id": "image_product", "label": "Or use a product photo", "info": "Used when no image is uploaded" },
      { "type": "range", "id": "image_n", "label": "Product photo number", "min": 1, "max": 10, "step": 1, "default": 1 },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "tight", "label": "Less spacing", "default": true }
  ],
  "presets": [ { "name": "Anime spotlight" } ]
}
{% endschema %}
