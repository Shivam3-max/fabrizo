<section class="edit" style="--edit-h: {{ section.settings.height }}px">
  {%- assign pi = section.settings.image_n | minus: 1 -%}
  {%- assign im = section.settings.image | default: section.settings.image_product.images[pi] -%}
  {%- if im -%}<img class="edit__img" style="--pos: {{ section.settings.focal }}" src="{{ im | image_url: width: 1800 }}" srcset="{{ im | image_url: width: 900 }} 900w, {{ im | image_url: width: 1800 }} 1800w" sizes="100vw" alt="{{ im.alt | escape }}" loading="lazy" width="{{ im.width }}" height="{{ im.height }}">{%- endif -%}
  <div class="page-width edit__inner">
    <div>
      <h2 class="edit__title">{{ section.settings.title }}</h2>
      {%- if section.settings.arabic != blank -%}<p class="edit__arabic" lang="ar">{{ section.settings.arabic }}</p>{%- endif -%}
    </div>
    <div class="edit__side">
      <p class="edit__kicker">{{ section.settings.kicker }} {%- if section.settings.kicker_italic != blank %} <em>{{ section.settings.kicker_italic }}</em>{% endif %}</p>
      {%- if section.settings.btn != blank -%}<a class="btn btn--ghost-light" href="{{ section.settings.link }}">{{ section.settings.btn }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Editorial banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "image_product", "label": "Or use a product photo", "info": "Used when no image is uploaded" },
      { "type": "range", "id": "image_n", "label": "Product photo number", "min": 1, "max": 10, "step": 1, "default": 1 },
    { "type": "select", "id": "focal", "label": "Image focus", "default": "center", "options": [ { "value": "center top", "label": "Top" }, { "value": "center", "label": "Centre" }, { "value": "center bottom", "label": "Bottom" } ] },
    { "type": "range", "id": "height", "label": "Height", "min": 320, "max": 720, "step": 10, "default": 460, "unit": "px" },
    { "type": "text", "id": "title", "label": "Title (Italiana)", "default": "Desert Nights" },
    { "type": "text", "id": "arabic", "label": "Arabic line" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The art of dressing" },
    { "type": "text", "id": "kicker_italic", "label": "Kicker italic part", "default": "(after dark)" },
    { "type": "text", "id": "btn", "label": "Button" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "Editorial banner" } ]
}
{% endschema %}
