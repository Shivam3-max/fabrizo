<section class="section section--tight">
  <div class="page-width trend">
    <span class="trend__label">{{ section.settings.title }}</span>
    {%- for block in section.blocks -%}<a class="pill" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Trending chips",
  "settings": [ { "type": "text", "id": "title", "label": "Label", "default": "Trending right now" } ],
  "blocks": [ { "type": "chip", "name": "Chip", "settings": [ { "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "link", "label": "Link" } ] } ],
  "presets": [ { "name": "Trending chips" } ]
}
{% endschema %}
