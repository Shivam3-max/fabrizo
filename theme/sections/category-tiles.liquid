<section class="section section--tight">
  <div class="page-width">
    {%- if section.settings.title != blank -%}<div class="sec-head"><h2 class="h-sec">{{ section.settings.title }}</h2></div>{%- endif -%}
    <div class="cat-tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign pi = block.settings.image_n | minus: 1
          assign im = block.settings.image | default: block.settings.image_product.images[pi] | default: col.image | default: col.products.first.featured_image
          assign label = block.settings.label | default: col.title
        -%}
        <a class="cat-tile" href="{{ col.url | default: block.settings.link }}" {{ block.shopify_attributes }}>
          {%- if im -%}<img src="{{ im | image_url: width: 700 }}" srcset="{{ im | image_url: width: 400 }} 400w, {{ im | image_url: width: 700 }} 700w" sizes="(min-width: 750px) 25vw, 50vw" alt="" loading="lazy" width="{{ im.width }}" height="{{ im.height }}">{%- endif -%}
          <span class="cat-tile__label">{{ label }}</span>
          {%- if section.settings.show_count and col.products_count > 0 -%}<span class="cat-tile__count">{{ col.products_count }} styles</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "checkbox", "id": "show_count", "label": "Show style count", "default": true }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Label (vertical)" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "product", "id": "image_product", "label": "Or use a product photo", "info": "Used when no image is uploaded" },
      { "type": "range", "id": "image_n", "label": "Product photo number", "min": 1, "max": 10, "step": 1, "default": 1 },
      { "type": "url", "id": "link", "label": "Link if no collection" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Category tiles" } ]
}
{% endschema %}
