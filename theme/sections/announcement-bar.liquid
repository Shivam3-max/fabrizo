{%- if section.blocks.size > 0 -%}
<div class="ann" data-ann>
  <div class="page-width ann__inner">
    <button type="button" class="ann__arrow" data-ann-prev aria-label="Previous message">{% render 'icon', name: 'chev-left', class: 'ico--sm' %}</button>
    <div class="ann__track" aria-live="polite">
      {%- for block in section.blocks -%}
        <p class="ann__msg{% if forloop.first %} is-on{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
        </p>
      {%- endfor -%}
    </div>
    <button type="button" class="ann__arrow" data-ann-next aria-label="Next message">{% render 'icon', name: 'chev-right', class: 'ico--sm' %}</button>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section--announcement",
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 4 }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Buy 3 Get 1 Free on all tees" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 6
}
{% endschema %}
