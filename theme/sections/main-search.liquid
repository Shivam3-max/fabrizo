{%- liquid
  assign anime_menu = settings.anime_menu
  if anime_menu.links == blank
    assign anime_menu = linklists[settings.anime_menu]
  endif
-%}
<div class="page-width section" style="padding-top:30px">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><span aria-current="page">Search</span></nav>
  <h1 class="coll__title" style="margin-top:10px">{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search{% endif %}</h1>
  <form action="{{ routes.search_url }}" method="get" class="hdr__search" style="max-width:560px;margin:16px 0 8px">
    {% render 'icon', name: 'search' %}<input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search anime, characters, designs…" aria-label="Search"><input type="hidden" name="type" value="product">
  </form>
  {%- if search.performed -%}<p class="sub" style="margin-bottom:22px">{{ search.results_count }} {% if search.results_count == 1 %}style{% else %}styles{% endif %}</p>{%- endif -%}
  {%- if search.performed and search.results_count > 0 -%}
    {%- paginate search.results by 36 -%}
      <div class="grid" style="--cols: 4">
        {%- for item in search.results -%}{%- if item.object_type == 'product' or item.variants -%}{% render 'product-card', product: item %}{%- endif -%}{%- endfor -%}
      </div>
    {%- endpaginate -%}
  {%- else -%}
    {%- if search.performed -%}<p class="sub">Nothing for that one. Try an anime:</p>{%- else -%}<p class="sub">Popular universes:</p>{%- endif -%}
    <div class="srch__chips" style="margin-top:14px">
      {%- for u in anime_menu.links -%}<a class="pill pill--uni" style="--uni: {% render 'uni', handle: u.object.handle, get: 'accent', collection: u.object %}" href="{{ u.url }}"><span class="uni-dot"></span>{{ u.title }}</a>{%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}{ "name": "Search results" }{% endschema %}
