<section class="section" id="reviews">
  <div class="page-width">
    <div class="revs__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h-sec h-sec--lg">{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.score != blank -%}
        <div class="revs__score"><b>{{ section.settings.score }}</b><div><span class="stars">★★★★★</span><p class="sub" style="margin:0">{{ section.settings.score_text }}</p></div></div>
      {%- endif -%}
    </div>
    <div class="revs__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="rev" {{ block.shopify_attributes }}>
          <div class="rev__top"><span class="stars">{% for i in (1..b.rating) %}★{% endfor %}</span><span>{{ b.source }}</span></div>
          {%- if b.heading != blank -%}<p class="rev__t">{{ b.heading }}</p>{%- endif -%}
          <p class="rev__b">{{ b.text }}</p>
          {%- if b.product -%}<a class="rev__prod" href="{{ b.product.url }}">On: {% render 'short-title', title: b.product.title %}</a>{%- endif -%}
          <p class="rev__who">{{ b.name }} {% if b.verified %}<small>· Verified buyer</small>{% endif %}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real customers" },
    { "type": "text", "id": "title", "label": "Heading", "default": "What the UAE is wearing" },
    { "type": "text", "id": "score", "label": "Score", "default": "4.9" },
    { "type": "text", "id": "score_text", "label": "Score text", "default": "From WhatsApp and website reviews" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "textarea", "id": "text", "label": "Review" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "source", "label": "Source", "default": "WhatsApp" },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true },
      { "type": "product", "id": "product", "label": "Product" }
    ] }
  ],
  "presets": [ { "name": "Reviews" } ]
}
{% endschema %}
