{%- comment -%}
  "Shop by world": big tiles for the store's worlds (Anime, Marvel, Mood Tees,
  Arabic…). Each tile takes its colour, vertical mark and tagline from the
  world look-up (snippets/uni) unless the block overrides them.
{%- endcomment -%}
<section class="section{% if section.settings.tight %} section--tight{% endif %}">
  <div class="page-width">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h-sec h-sec--lg">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="sub">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
    <div class="worlds" style="--n: {{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign col = b.collection
          assign pi = b.image_n | minus: 1
          assign im = b.image | default: b.image_product.images[pi] | default: col.image | default: col.products.first.featured_image
          capture acc
            render 'uni', handle: col.handle, get: 'accent', collection: col
          endcapture
          capture mark
            render 'uni', handle: col.handle, get: 'kanji', collection: col
          endcapture
          capture line
            render 'uni', handle: col.handle, get: 'line', collection: col
          endcapture
          if b.accent != blank
            assign acc = b.accent
          endif
          if b.mark != blank
            assign mark = b.mark
          endif
          if b.text != blank
            assign line = b.text
          endif
        -%}
        <a class="world" href="{{ b.link | default: col.url }}" style="--uni: {{ acc }}" {{ block.shopify_attributes }}>
          {%- if im -%}<img class="world__img" src="{{ im | image_url: width: 700 }}" srcset="{{ im | image_url: width: 400 }} 400w, {{ im | image_url: width: 700 }} 700w" sizes="(min-width: 990px) 25vw, 50vw" alt="" loading="lazy" width="{{ im.width }}" height="{{ im.height }}">{%- endif -%}
          {%- if mark != blank -%}<span class="world__mark" aria-hidden="true">{{ mark }}</span>{%- endif -%}
          <span class="world__body">
            {%- if col.products_count > 0 -%}<span class="world__count">{{ col.products_count }} designs</span>{%- endif -%}
            <span class="world__t">{{ b.label | default: col.title }}</span>
            {%- if line != blank -%}<span class="world__line">{{ line }}</span>{%- endif -%}
            <span class="world__cta">Shop {{ b.label | default: col.title }} {% render 'icon', name: 'arrow-right', class: 'ico--sm' %}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop by world",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More than anime" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by world" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "tight", "label": "Less spacing", "default": false }
  ],
  "blocks": [
    { "type": "world", "name": "World", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Label (defaults to collection title)" },
      { "type": "text", "id": "text", "label": "Tagline (defaults to the world's own line)" },
      { "type": "text", "id": "mark", "label": "Vertical mark (e.g. AVENGERS, アニメ)" },
      { "type": "color", "id": "accent", "label": "Colour (defaults to the world's own)" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "product", "id": "image_product", "label": "Or use a product photo" },
      { "type": "range", "id": "image_n", "label": "Product photo number", "min": 1, "max": 10, "step": 1, "default": 1 },
      { "type": "url", "id": "link", "label": "Link override" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Shop by world" } ]
}
{% endschema %}
