{%- comment -%}
  Prints "handle|title|url" of the product's world: first an anime universe
  (product.collections matched against the anime menu), otherwise a world
  collection from the theme setting "World collections" (Marvel, Mood Tees…).
  Pass anime_only: true to skip worlds. Prints nothing if none.
{%- endcomment -%}
{%- liquid
  assign anime_menu = settings.anime_menu
  if anime_menu.links == blank
    assign anime_menu = linklists[settings.anime_menu]
    if anime_menu.links == blank
      assign anime_menu = linklists['anime']
    endif
  endif
  assign found = ''
  for c in product.collections
    for l in anime_menu.links
      if l.object.handle == c.handle and found == blank
        assign found = c.handle | append: '|' | append: c.title | append: '|' | append: c.url
      endif
    endfor
  endfor
  if found == blank and anime_only != true
    assign world_handles = settings.world_collections | default: 'marvel, mood-tees' | remove: ' ' | prepend: '|' | append: '|' | replace: ',', '|'
    for c in product.collections
      assign wh = c.handle | prepend: '|' | append: '|'
      if world_handles contains wh and found == blank
        assign found = c.handle | append: '|' | append: c.title | append: '|' | append: c.url
      endif
    endfor
  endif
  echo found
-%}
