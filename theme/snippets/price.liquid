{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign p = target.price | default: product.price
  assign cp = target.compare_at_price
  assign on_sale = false
  if cp > p
    assign on_sale = true
    assign off = cp | minus: p | times: 100 | divided_by: cp | floor
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}" data-price>
  <span class="price__now">{% if product.price_varies and variant == blank and show_from %}From {% endif %}{{ p | money }}</span>
  {%- if on_sale -%}
    <s class="price__was">{{ cp | money }}</s>
    {%- if show_off -%}<span class="price__off">-{{ off }}%</span>{%- endif -%}
  {%- endif -%}
</div>
