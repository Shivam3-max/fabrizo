{%- comment -%} Cart drawer shell. Lines are drawn by theme.js from /cart.js so every add/change is instant. {%- endcomment -%}
{%- liquid
  assign anime_menu = settings.anime_menu
  if anime_menu.links == blank
    assign anime_menu = linklists[settings.anime_menu]
    if anime_menu.links == blank
      assign anime_menu = linklists['anime']
    endif
  endif
-%}
<aside class="drawer" id="cart-drawer" data-drawer="cart" aria-label="Your bag" aria-hidden="true" tabindex="-1">
  <div class="drawer__head">
    <span class="drawer__title">Your bag <span data-cart-count-text>({{ cart.item_count }})</span></span>
    <button type="button" class="hdr__icon" data-close aria-label="Close bag">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="cart-progress" data-ship-bar>
    <span data-ship-text>{% if settings.offer_enabled %}Spend {{ settings.offer_1_spend | times: 100 | money }} to get {{ settings.offer_1_reward }}{% else %}Free UAE delivery on every order{% endif %}</span>
    <div class="ship-bar__track"><div class="ship-bar__fill" data-ship-fill></div></div>
  </div>
  <div class="cart-offer">{% render 'icon', name: 'truck', class: 'ico--sm' %}<span>{% if settings.free_shipping_threshold > 0 %}Free UAE delivery over {{ settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros }}{% else %}<b>Free UAE delivery</b> on every order{% endif %} · Cash on delivery available</span></div>
  <div class="drawer__body" data-cart-lines></div>
  <div class="drawer__foot" data-cart-foot>
    <div class="cart-sum"><span>Subtotal</span><span data-cart-total>{{ cart.total_price | money }}</span></div>
    <p class="cart-note">Tax included. Offers and shipping are calculated at checkout. Cash on delivery available.</p>
    <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="btn btn--block">Checkout</button></form>
    <a href="{{ routes.cart_url }}" class="btn btn--outline btn--block" style="margin-top:8px">View bag</a>
  </div>
  <script type="application/json" data-cart-empty-links>[{%- for l in anime_menu.links limit: 5 -%}{"t":{{ l.title | json }},"u":{{ l.url | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]</script>
</aside>
